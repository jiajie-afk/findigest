# Optional API origin when the SPA is not served from the same host as /api/*.
# Leave empty for same-origin (Vite/Vercel default).
VITE_API_BASE=

# Browser JSONP fallback when /api/proxy fails.
# Production builds default to false (proxy-only) unless explicitly set true.
# Local/dev without a running proxy may set true so quotes still resolve.
# VITE_ALLOW_JSONP=true

# Server-only (Vercel / api): HMAC secret for httpOnly fd_sess vault cookie.
# Required in production for post-login cloud sync without re-sending OTP.
# VAULT_SESSION_SECRET=generate-a-long-random-string

# Server-only: Vercel Blob token for encrypted vault sync (blobs stored private).
# BLOB_READ_WRITE_TOKEN=

# Skip legacy public-blob list/fetch fallback (faster; set after migrating vaults to private).
# BLOB_SKIP_PUBLIC_FALLBACK=1

# Comma-separated browser origins allowed for credentialed CORS (auth/vault/billing/proxy).
# Same-origin deploys can leave empty. Example:
# CORS_ORIGINS=https://findigest-three.vercel.app,https://www.findigest.cn

# --- Capacity (multi-instance) ---
# Upstash Redis REST — makes rate limits + redeem locks global across Vercel isolates.
# Strongly recommended before heavy traffic. Create a free DB at https://upstash.com
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Proxy knobs (defaults are safe for mid traffic)
# PROXY_MAX_BYTES=1048576
# PROXY_TIMEOUT_MS=10000
# PROXY_MAX_INFLIGHT=48
# PROXY_IP_LIMIT=90
# PROXY_IP_WINDOW_MS=60000

# Allow hardcoded demo redeem seeds on /api/billing (never enable on production).
# BILLING_ALLOW_DEMO_SEEDS=1

# --- Supabase (optional client; Auth hooks live under supabase/functions/) ---
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- OTP delivery: Aliyun first (China), Resend fallback ---
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# SMS (Dysmsapi) — template must expose ${code}
# ALIYUN_SMS_SIGN_NAME=FinDigest
# ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxxxx
# DirectMail — verified sender address
# ALIYUN_DM_ACCOUNT_NAME=noreply@mail.example.com
# ALIYUN_DM_FROM_ALIAS=FinDigest
# ALIYUN_DM_REGION=cn-hangzhou

# Resend fallback (optional if Aliyun mail is configured)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=FinDigest <onboarding@resend.dev>

# HMAC secret for OTP hashes + emailProof (required in production).
# EMAIL_OTP_SECRET=generate-a-long-random-string

# Owner ops console (/ops, /admin redirects here) — grant/revoke Pro, ban, issue redeem codes.
# ADMIN_SECRET=generate-a-long-random-string
# Force revealing OTP in API JSON (dev only — ignored when VERCEL/production).
# EMAIL_DEV_REVEAL=1
